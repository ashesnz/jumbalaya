{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
  "runtime": {
    "version": "LuaJIT",
    "requirePattern": [
      "?.lua",
      "?/init.lua"
    ]
  },
  "workspace": {
    "workspaceRoots": [
      "."
    ],
    "ignoreDir": [
      "dice-have-no-eyes",
      "_tools"
    ],
    "ignoreGlobs": [
      "dictionary/words_set.lua"
    ]
  },
  "diagnostics": {
    "globals": [
      "unlock_card",
      "discover_card",
      "Kind",
      "Node",
      "AnimNode",
      "EaseNode",
      "SceneNode",
      "Sprite",
      "GfxSprite",
      "SpriteAnimator",
      "GfxAnimator",
      "Tween",
      "Scheduler",
      "InputRouter",
      "InputController",
      "RetainedPanel",
      "LayoutNode",
      "ParticleEmitter",
      "Particles",
      "FlowText",
      "Game",
      "Card",
      "CardPile",
      "TitleLogo",
      "localize"
    ],
    "disable": [
      "inject-field",
      "missing-fields",
      "access-invisible"
    ]
  },
  "strict": {
    "metaOverrideFileDefine": true
  }
}
